# ─── Data mode ────────────────────────────────────────────────────────────
# "demo"  → local seeded data, works offline-ish, syncs only between tabs of one browser
# "live"  → Supabase (persistent, real cross-device realtime)
# If omitted: "live" when both Supabase vars are set, otherwise "demo".
VITE_DATA_MODE=demo

# ─── Supabase (Live Mode) ─────────────────────────────────────────────────
# Project Settings → API. Use the *anon / publishable* key ONLY.
# NEVER put the service_role / secret key in any VITE_ variable — it ships to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Map ──────────────────────────────────────────────────────────────────
# Any MapLibre-compatible style URL. Default: OpenFreeMap "positron" (re-tinted bright at runtime) (free, no key,
# fair-use — see https://openfreemap.org). For heavy traffic use MapTiler/Stadia/your own tiles.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Default camera: "lat,lng" and zoom. Default is Lake Tahoe (big lake = natural-looking demo data).
VITE_DEFAULT_CENTER=39.09,-120.04
VITE_DEFAULT_ZOOM=10

# ─── Product tuning ───────────────────────────────────────────────────────
VITE_REPORT_TTL_MINUTES=30
VITE_SUBMIT_COOLDOWN_SECONDS=20
# Show the "Simulate sighting" button (Demo Mode only; ignored in Live Mode).
VITE_ENABLE_SIMULATOR=true

# ─── Live smoke test only (NOT a VITE_ var, never shipped) ─────────────────
# A test-only invite code so `npm run test:live` doesn't consume real member seats.
SMOKE_INVITE_CODE=

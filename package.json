{
  "name": "fishpulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FishPulse — a real-time, community-powered fishing activity map.",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node scripts/live-smoke-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
